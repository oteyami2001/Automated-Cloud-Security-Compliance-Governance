# Copy to backend.tf (git-ignored) after the first local apply, then run:
#   terraform init -migrate-state
terraform {
  backend "s3" {
    bucket       = "acscg-tfstate-<ACCOUNT_ID>-us-east-2"
    key          = "bootstrap/terraform.tfstate"
    region       = "us-east-2"
    encrypt      = true
    kms_key_id   = "alias/acscg-tfstate"
    use_lockfile = true
  }
}
