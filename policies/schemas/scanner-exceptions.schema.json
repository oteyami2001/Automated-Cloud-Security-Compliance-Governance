{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ACSCG scanner suppression register",
  "type": "object",
  "additionalProperties": false,
  "required": ["suppressions"],
  "properties": {
    "suppressions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tool", "rule", "path", "justification", "owner", "review_by"],
        "properties": {
          "tool": {"enum": ["checkov", "trivy", "tflint", "bandit", "ruff"]},
          "rule": {"type": "string", "minLength": 2},
          "path": {"type": "string", "minLength": 1},
          "justification": {"type": "string", "minLength": 20},
          "owner": {"type": "string"},
          "review_by": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
        }
      }
    }
  }
}
