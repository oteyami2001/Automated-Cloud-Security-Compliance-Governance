{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oteyami2001/Automated-Cloud-Security-Compliance-Governance/controls/schema/control-catalog.schema.json",
  "title": "ACSCG security control catalog",
  "type": "object",
  "required": ["catalog", "controls"],
  "additionalProperties": false,
  "properties": {
    "catalog": {
      "type": "object",
      "required": ["name", "version", "status", "owner", "last_reviewed", "defaults"],
      "properties": {
        "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "status": {"enum": ["draft", "approved"]},
        "defaults": {
          "type": "object",
          "required": ["remediation_mode", "exception_max_days", "required_tags"],
          "properties": {
            "remediation_mode": {"const": "report_only"},
            "exception_max_days": {"type": "integer", "minimum": 1, "maximum": 90}
          }
        }
      }
    },
    "controls": {
      "type": "array",
      "minItems": 15,
      "items": {"$ref": "#/$defs/control"}
    }
  },
  "$defs": {
    "control": {
      "type": "object",
      "required": [
        "id", "title", "domain", "description", "rationale", "resource_types", "severity",
        "detection", "evaluation_logic", "remediation", "approval", "evidence_requirements",
        "frameworks", "mapping_relationship", "exception_policy", "verification",
        "implementation_status"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^SEC-\\d{3}$"},
        "title": {"type": "string", "minLength": 3},
        "domain": {"enum": ["data-protection", "network-security", "compute-security", "identity-access", "logging-monitoring", "governance", "change-management"]},
        "description": {"type": "string", "minLength": 20},
        "rationale": {"type": "string", "minLength": 20},
        "resource_types": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^AWS::"}},
        "severity": {"enum": ["critical", "high", "medium", "low", "informational"]},
        "severity_escalation": {"type": "string"},
        "detection": {
          "type": "object",
          "required": ["method", "verification"],
          "properties": {
            "method": {"enum": ["config_managed_rule", "config_custom_rule", "cloudtrail_eventbridge", "hybrid"]},
            "config_managed_rules": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z0-9_]+$"}},
            "securityhub_controls": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9]+\\.\\d+$"}},
            "verification": {"enum": ["pending", "verified"]},
            "securityhub_verification": {"enum": ["pending", "secondary-source", "verified"]}
          }
        },
        "evaluation_logic": {"type": "string", "minLength": 20},
        "remediation": {
          "type": "object",
          "required": ["eligibility"],
          "properties": {
            "eligibility": {"enum": ["report_only", "auto_low_risk", "human_approval", "escalate"]}
          },
          "allOf": [
            {
              "if": {"properties": {"eligibility": {"enum": ["auto_low_risk", "human_approval"]}}},
              "then": {"required": ["action", "runbook", "scope", "never", "preconditions", "rollback"]}
            }
          ]
        },
        "approval": {
          "type": "object",
          "required": ["required"],
          "properties": {"required": {"type": "boolean"}}
        },
        "evidence_requirements": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "frameworks": {
          "type": "object",
          "required": ["nist_800_53_r5", "cis_aws_v5_0_0", "cis_aws_v6_0_0", "pci_dss_v4_0_1", "soc2_tsc_2017"],
          "additionalProperties": false,
          "properties": {
            "nist_800_53_r5": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Z]{2}-\\d+(\\(\\d+\\))?$"}},
            "cis_aws_v5_0_0": {"type": "array", "items": {"type": "string", "pattern": "^\\d+(\\.\\d+)+$"}},
            "cis_aws_v6_0_0": {"type": "array", "items": {"type": "string", "pattern": "^\\d+(\\.\\d+)+$"}},
            "pci_dss_v4_0_1": {"type": "array", "items": {"type": "string", "pattern": "^(\\d+\\.){2,3}\\d+$"}},
            "soc2_tsc_2017": {"type": "array", "items": {"type": "string", "pattern": "^(CC\\d|A1|C1|PI1|P\\d)\\.\\d+$"}}
          }
        },
        "mapping_relationship": {"enum": ["direct", "partial", "supporting"]},
        "mapping_notes": {"type": "string"},
        "exception_policy": {
          "type": "object",
          "required": ["allowed"],
          "properties": {"allowed": {"type": "boolean"}},
          "if": {"properties": {"allowed": {"const": true}}},
          "then": {"required": ["requires"]}
        },
        "verification": {
          "type": "object",
          "required": ["procedure", "expected"]
        },
        "implementation_status": {"enum": ["planned", "implemented", "tested-offline", "verified-in-aws"]}
      },
      "allOf": [
        {
          "if": {"properties": {"remediation": {"properties": {"eligibility": {"const": "human_approval"}}}}},
          "then": {"properties": {"approval": {"properties": {"required": {"const": true}}, "required": ["approvers", "timeout"]}}}
        },
        {
          "if": {"properties": {"remediation": {"properties": {"eligibility": {"enum": ["report_only", "escalate"]}}}}},
          "then": {"properties": {"approval": {"properties": {"required": {"const": false}}}}}
        }
      ]
    }
  }
}
